{
  "name": "language-lab",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "speech-test": "vite --config vite.speech-test.config.ts",
    "layout-check": "node tools/layout-check/run.mjs",
    "test:hooks": "python3 .kiro/hooks/scripts/test_block_sensitive_paths.py",
    "check:answer-key": "python3 tools/answer-key/check-against-source.py"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/dom-speech-recognition": "0.0.12",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "fast-check": "3.23.2",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
