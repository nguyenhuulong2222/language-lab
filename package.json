{
  "name": "language-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "speech-test": "vite --config vite.speech-test.config.ts"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@types/dom-speech-recognition": "0.0.12",
    "@cloudflare/workers-types": "5.20261101.1",
    "@fast-check/vitest": "0.5.0",
    "@vitejs/plugin-react": "4.5.2",
    "fast-check": "3.23.2",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
