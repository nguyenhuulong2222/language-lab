# Dependencies
node_modules/

# Build output
dist/
.output/

# Vite / TypeScript
*.tsbuildinfo
vite.config.ts.timestamp-*

# Environment and secrets — never commit these
.env
.env.*
!.env.example
.dev.vars

# Local tool-specific .env files (e.g. tools/speech-test/.env)
tools/**/.env

# Generated audio of the speech-test tool only (run tools/speech-test/generate-audio.mjs)
tools/speech-test/audio/
# NOTE: public/audio/ (the practice flow's pre-generated prompts) is committed on purpose:
# it must deploy with the site. Do not ignore it.

# Local audio recordings (device-local only, never committed)
local-recordings/
*.local-recording

# macOS
.DS_Store

# Editor
.vscode/
*.swp
*.swo

# Wrangler
.wrangler/

# Logs
*.log
npm-debug.log*
