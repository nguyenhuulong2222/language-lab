# Language Lab — environment variable template
# Copy to .env.local for local Vite development.
# For the Cloudflare Worker, set secrets via `wrangler secret put` or the dashboard.
# Never put real values in this file.

# Vite public variables (exposed to the browser — no secrets here)
VITE_APP_ENV=development

# Worker variables (set in Cloudflare dashboard or .dev.vars for local wrangler dev)
# LANGUAGE_LAB_API_KEY=
