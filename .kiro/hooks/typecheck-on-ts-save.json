{
  "version": "v1",
  "hooks": [
    {
      "name": "Typecheck on TS save",
      "trigger": "PostFileSave",
      "description": "Run typecheck whenever the agent saves any .ts or .tsx file",
      "matcher": "\\.(ts|tsx)$",
      "action": {
        "type": "command",
        "command": "cd /Volumes/Crucial1TB/language-lab && npm run typecheck",
        "timeout": 60
      }
    }
  ]
}